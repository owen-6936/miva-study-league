{
  "name": "miva-study-league",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "description": "MIVA Study League — Gamified Academic Competition Platform for MIVA Open University",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "openapi:validate": "npm exec --yes @redocly/cli@1.34.5 -- lint --config .redocly.yaml docs/api/openapi.yaml"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "@hookform/resolvers": "^5.0.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.9.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "gsap": "^3.12.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-router": "^7.6.0",
    "recharts": "^2.15.0",
    "socket.io-client": "^4.8.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0"
  }
}